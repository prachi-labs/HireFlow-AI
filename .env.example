# GEMINI_API_KEY: Required for Gemini AI API calls (default LLM provider).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Publicly reachable HTTPS URL (required for Twilio Media Streams webhooks).
APP_URL="MY_APP_URL"

# Session signing secret (auto-generated dev fallback if unset; set strong random hex in prod)
SESSION_SECRET=""

# Optional Alternative LLM Provider (swappable via Settings / LLM adapter)
ANTHROPIC_API_KEY=""

# Optional Telephony Provider (Twilio Programmable Voice + Media Streams)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional Exotel (India Telephony)
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SID=""
EXOTEL_CALLER_ID=""

# Optional Streaming Speech-to-Text (Deepgram)
DEEPGRAM_API_KEY=""

# Optional Neural Text-to-Speech (ElevenLabs or Azure Neural Speech)
ELEVENLABS_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# Optional Email Provider (SMTP for Level 2 invitations & password reset)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HireFlow AI <recruitment@hireflow.ai>"
